/* ============================================================
   FACOT MASTER TEMPLATE (Fixed Dropdowns & Visibility)
   ============================================================ */

/* --- GLOBAL --- */
QMainWindow, QDialog {
    background-color: {{background}};
    color: {{foreground}};
}

QWidget {
    font-family: "Segoe UI", "San Francisco", "Helvetica Neue", Arial, sans-serif;
    font-size: 9pt;
    color: {{foreground}};
}

/* --- SIDEBAR --- */
QWidget#sidebar {
    background-color: {{sidebar_bg}};
    border-right: 1px solid {{border}};
    min-width: 220px;
    max-width: 220px;
}
QWidget#sidebar QPushButton {
    background-color: transparent;
    color: {{sidebar_fg}};
    border: none;
    border-radius: 6px;
    padding: 10px 12px;
    text-align: left;
    font-weight: 500;
    margin: 2px 8px;
}
QWidget#sidebar QPushButton:hover {
    background-color: {{surface_alt}};
    color: {{primary}};
}
QWidget#sidebar QPushButton:checked,
QWidget#sidebar QPushButton:pressed {
    background-color: {{primary}};
    color: {{primary_text}};
}

/* --- TOPBAR --- */
QWidget#topbar {
    background-color: {{surface}};
    border-bottom: 1px solid {{border}};
    min-height: 56px;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: {{primary}};
    color: {{primary_text}};
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 9pt;
    font-weight: 600;
    min-height: 28px;
}
QPushButton:hover { background-color: {{primary_hover}}; }
QPushButton:pressed { background-color: {{border}}; }
QPushButton:disabled {
    background-color: {{surface_alt}};
    color: {{foreground_muted}};
    border: 1px solid {{border}};
}

/* Secondary Button */
QPushButton[secondary="true"] {
    background-color: transparent;
    color: {{primary}};
    border: 1px solid {{border}};
}
QPushButton[secondary="true"]:hover {
    border-color: {{primary}};
    background-color: {{surface_alt}};
}

/* --- INPUTS (LINEAS VISIBLES) --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: {{input_bg}};
    color: {{foreground}};
    border: 1px solid {{input_border}}; /* Borde visible */
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 28px; 
    selection-background-color: {{selection_bg}};
    selection-color: {{selection_text}};
}

QLineEdit:hover, QSpinBox:hover { border-color: {{primary}}; }
QLineEdit:focus, QSpinBox:focus {
    border: 2px solid {{primary}};
    padding: 5px 9px; /* Ajuste por el borde de 2px */
    outline: none;
}

/* --- COMBOBOX & DATEEDIT (Solucion Menu Negro) --- */
QComboBox, QDateEdit {
    background-color: {{input_bg}};
    color: {{foreground}};
    border: 1px solid {{input_border}};
    border-radius: 4px;
    padding: 6px 10px;
    padding-right: 30px; /* Espacio para el icono */
    min-height: 28px;
}

QComboBox:hover, QDateEdit:hover {
    border-color: {{primary}};
}
QComboBox:focus, QDateEdit:focus {
    border: 2px solid {{primary}};
    padding: 5px 9px;
}

/* ESTILO DEL POPUP DESPLEGABLE (Crucial para tema Light) */
QComboBox QAbstractItemView {
    background-color: {{popup_bg}}; /* Fondo explícito */
    color: {{popup_text}};         /* Texto explícito */
    border: 1px solid {{border}};
    selection-background-color: {{primary}};
    selection-color: {{primary_text}};
    outline: none;
}

/* BOTONES DEL INPUT */
QComboBox::drop-down, QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px; 
    border-left-width: 1px;
    border-left-color: {{input_border}};
    border-left-style: solid; 
    border-top-right-radius: 4px; 
    border-bottom-right-radius: 4px;
    background-color: {{surface_alt}}; /* Efecto botón */
}

QComboBox::drop-down:hover, QDateEdit::drop-down:hover {
    background-color: {{border}};
}

/* ICONOS */
QComboBox::down-arrow {
    image: {{icon_arrow}};
    width: 10px; height: 10px;
}

QDateEdit::down-arrow {
    image: {{icon_calendar}};
    width: 12px; height: 12px;
}

/* --- CALENDAR WIDGET --- */
QCalendarWidget {
    border: 1px solid {{border}};
    border-radius: 6px;
    background-color: {{calendar_bg}};
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: {{calendar_nav_bg}};
    border-bottom: 1px solid {{border}};
}
QCalendarWidget QToolButton {
    background-color: transparent;
    color: {{foreground}};
    border: none;
    border-radius: 4px;
    font-weight: bold;
    padding: 4px;
}
QCalendarWidget QToolButton:hover {
    background-color: {{surface_alt}};
}
QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: none; 
    image: {{icon_arrow}}; 
}

QCalendarWidget QAbstractItemView {
    background-color: {{calendar_bg}};
    color: {{calendar_text}};
    selection-background-color: {{primary}};
    selection-color: {{primary_text}};
    outline: none;
}

/* --- TABLES --- */
QTableWidget, QTableView {
    background-color: {{surface}};
    alternate-background-color: {{surface_alt}};
    gridline-color: {{table_grid}};
    border: 1px solid {{border}};
    border-radius: 6px;
    selection-background-color: {{selection_bg}};
    selection-color: {{selection_text}};
}
QHeaderView::section {
    background-color: {{table_header_bg}};
    color: {{foreground_muted}};
    border: none;
    border-bottom: 2px solid {{border}};
    padding: 8px 12px;
    font-weight: 600;
}

/* --- OTHERS --- */
QWidget[totalsSection="true"] {
    background-color: {{surface}};
    border-top: 2px solid {{primary}};
    padding: 12px 16px;
    border-radius: 0 0 6px 6px;
}
QWidget[totalsSection="true"] QLabel[totalAmount="true"] {
    font-size: 11pt;
    font-weight: 800;
    color: {{primary}};
}

QScrollBar:vertical {
    background-color: {{background}};
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: {{border}};
    border-radius: 5px;
    min-height: 20px;
}